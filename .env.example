# TrustLens AI - Environment Configuration Example

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=False

# Security & CORS — generate a unique SECRET_KEY for each deployment
# SECRET_KEY=  # auto-generated if empty

ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://trustlens-ai.vercel.app

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=trustlens_db

# NVIDIA NIM AI Configuration
NVIDIA_NIM_API_KEY=nvapi-your-nvidia-nim-api-key-here
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_NAME=meta/llama-3.3-70b-instruct

# EasyOCR Engine Configuration
OCR_GPU=False
OCR_LANGUAGES=en,hi

# Frontend Public API URL
NEXT_PUBLIC_API_URL=http://localhost:8000
